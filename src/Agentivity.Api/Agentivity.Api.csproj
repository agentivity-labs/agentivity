<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Agentivity.Api</RootNamespace>
    <EnableNETAnalyzers>False</EnableNETAnalyzers>
    <RunAnalyzersDuringLiveAnalysis>False</RunAnalyzersDuringLiveAnalysis>
    <RunAnalyzersDuringBuild>False</RunAnalyzersDuringBuild>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Agentivity.Host\Agentivity.Host.csproj" />
    <ProjectReference Include="..\Agentivity.Infrastructure\Agentivity.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Chats\" />
    <Folder Include="Forms\" />
  </ItemGroup>
  <!--
    The platform references no module: modules are loaded from _modules at start-up. They are built by Agentivity.Modules.proj,
    which this runs first so that a build (F5) leaves every module copied. An edition build turns it off (BuildModules=false)
    because it builds exactly the modules of its manifest, one by one.
  -->
  <PropertyGroup>
    <AgentivityModulesProject>$(MSBuildThisFileDirectory)..\..\Agentivity.Modules.proj</AgentivityModulesProject>
  </PropertyGroup>
  <Target Name="BuildAgentivityModules" BeforeTargets="BeforeBuild" Condition="'$(BuildModules)' != 'false' And Exists('$(AgentivityModulesProject)')">
    <MSBuild Projects="$(AgentivityModulesProject)" Targets="Build" />
  </Target>
</Project>
