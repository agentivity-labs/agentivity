{
  "LlmRecovery": {
    "MaxRetries": 2
  },
  "WorkflowEngine": {
    "ThrottleCpuPercent": 90,
    "ThrottleMemoryPercent": 80,
    "ThrottleDelayLowMs": 200,
    "ThrottleDelayHighMs": 500,
    "ThrottleDelayCriticalMs": 1000
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5005"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Agentivity": "Debug"
    }
  },
  "Logs": {
    "Path": "_logs/agentivity-.log",
    "RollingInterval": "Day",
    "RetainedFileCountLimit": 15,
    "FileSizeLimitBytes": 52428800,
    "RollOnFileSizeLimit": true,
    "OutputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Agentivity": "Debug",
        "Agentivity.Infrastructure.Workflow.Catalog.Nodes.Seo": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:HH:mm:ss} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ]
  },
  "OpenTelemetry": {
    "Endpoint": "",
    "Protocol": "HttpProtobuf",
    "ServiceName": "Agentivity.Api"
  },
  "Workflows": {
    "StoragePath": "_data/store/workflows.json"
  },
  "Configuration": {
    "StoragePath": "_data/config"
  },
  "Credentials": {
    "StoragePath": "_data/credentials.json"
  },
  "AppSettings": {
    "StoragePath": "_data/settings.json"
  },
  "PromptEngine": {
    "StoragePath": "_data/store/prompts.json",
    "CachePath": "_cache/prompts/executions"
  },
  "DataTables": {
    "StoragePath": "_data/store/datatables.json"
  },
  "Features": {
    "Source": "None",
    "LocalPath": "",
    "RemoteUrl": "",
    "StartupFetch": false,
    "AgenticLibrary": {
      "Enabled": false
    }
  },
  "LLMModels": {
    "StoragePath": "_cache/llmmodels/"
  },
  "Modules": {
    "StoragePath": "_modules/",
    "Registrations": [
      {
        "Type": "Agentivity.Infrastructure.Graph.GraphHostV1.Module, Agentivity.Infrastructure.Graph.GraphHostV1",
        "AssemblyPath": "Agentivity.Infrastructure.Graph.GraphHostV1.dll",
        "Enabled": true
      },
      {
        "Type": "Agentivity.Module.Workspace.Json.Basic.Module, Agentivity.Module.Workspace.Json.Basic",
        "AssemblyPath": "Agentivity.Module.Workspace.Json.Basic.dll",
        "Enabled": true
      },
      {
        "Type": "Agentivity.Infrastructure.Agentic.AgentEngineV1.Module, Agentivity.Infrastructure.Agentic.Agent.AgentEngineV1",
        "AssemblyPath": "Agentivity.Infrastructure.Agentic.Agent.AgentEngineV1.dll",
        "Enabled": true
      },
      {
        "Type": "Agentivity.Module.PromptEngine.Module, Agentivity.Module.PromptEngine",
        "AssemblyPath": "Agentivity.Module.PromptEngine.dll",
        "Enabled": true
      },
      {
        "Type": "Agentivity.Module.CodeExecution.Module, Agentivity.Module.CodeExecution",
        "AssemblyPath": "Agentivity.Module.CodeExecution.dll",
        "Enabled": true
      },
      {
        "Type": "Agentivity.Module.Assistant.Module, Agentivity.Module.Assistant",
        "AssemblyPath": "Agentivity.Module.Assistant.dll",
        "Enabled": true
      }
    ]
  },
  "CodeExecution": {
    "NodeExecutablePath": "node",
    "PoolSize": 2,
    "MaxOldSpaceSizeMb": 64
  },
  "Plugins": {
    "StoragePath": "_plugins/"
  },
  "WorkflowRunRetention": {
    "KeepCompletedDays": 7,
    "KeepFailedDays": 30,
    "KeepCancelledDays": 3,
    "CleanupIntervalMinutes": 60,
    "MaxRunsToKeep": 1000
  },
  "WaitingRuns": {
    "StoragePath": "_cache/workflows/executions"
  },
  "Paths": {
    "CacheDir": "_cache",
    "ImageCacheDir": "_cache/images",
    "DataDir": "_data",
    "DebugDir": "_cache/debug",
    "LogsDir": "_logs"
  },
  "ImageCache": {
    "Directory": "_cache/images",
    "RetentionDays": 7,
    "CleanupIntervalMinutes": 60,
    "ConvertToWebP": false,
    "WebPQuality": 85
  },
  "AudioCache": {
    "Directory": "_cache/audio",
    "RetentionDays": 7,
    "CleanupIntervalMinutes": 60
  },
  "UploadCache": {
    "Directory": "_cache/uploads",
    "RetentionDays": 7,
    "CleanupIntervalMinutes": 60,
    "MaxFileSizeMb": 10
  },
  "AgenticLibrary": {
    "StoragePath": "_data/store/agentic.json"
  }
}
