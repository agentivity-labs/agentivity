<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Agentivity.Module.CodeExecution</AssemblyName>
    <RootNamespace>Agentivity.Module.CodeExecution</RootNamespace>
    <EnableNETAnalyzers>False</EnableNETAnalyzers>
    <ModuleOutputDirectory>$(MSBuildProjectDirectory)\..\..\_modules\</ModuleOutputDirectory>
    <RunnerOutputDirectory>$(ModuleOutputDirectory)codeexecution-runner\</RunnerOutputDirectory>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Agentivity.Unit.Module.CodeExecution</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <Using Include="Microsoft.AspNetCore.Builder" />
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Hosting" />
    <Using Include="Microsoft.Extensions.Logging" />
    <Using Include="Microsoft.Extensions.Options" />
    <Using Include="Agentivity.Infrastructure.CodeExecution" />
    <Using Include="Agentivity.Infrastructure.Modules" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\Agentivity.Infrastructure\Agentivity.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Not compiled — copied to _modules\codeexecution-runner\ alongside the module DLL so the
         runner process (spawned from there at runtime) can find its own script + node_modules. -->
    <None Include="runner\**" CopyToOutputDirectory="PreserveNewest" Exclude="runner\node_modules\**\*.md;runner\node_modules\**\*.markdown" />
  </ItemGroup>
  <Target Name="CopyModuleToModulesDirectory" AfterTargets="Build">
    <MakeDir Directories="$(ModuleOutputDirectory)" />
    <Copy SourceFiles="$(TargetPath)"
          DestinationFolder="$(ModuleOutputDirectory)"
          SkipUnchangedFiles="true" />
    <ItemGroup>
      <RunnerAssets Include="runner\**" />
    </ItemGroup>
    <Copy SourceFiles="@(RunnerAssets)"
          DestinationFolder="$(RunnerOutputDirectory)%(RecursiveDir)"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
