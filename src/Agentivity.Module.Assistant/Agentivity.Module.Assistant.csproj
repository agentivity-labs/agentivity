<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Agentivity.Module.Assistant</AssemblyName>
    <RootNamespace>Agentivity.Module.Assistant</RootNamespace>
    <EnableNETAnalyzers>False</EnableNETAnalyzers>
    <ModuleOutputDirectory>$(MSBuildProjectDirectory)\..\..\_modules\</ModuleOutputDirectory>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Agentivity.Unit.Module.Assistant</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.AspNetCore.Builder" />
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Logging" />
    <Using Include="Agentivity.Infrastructure.Modules" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\Agentivity.Domain\Agentivity.Domain.csproj" />
    <ProjectReference Include="..\Agentivity.Infrastructure\Agentivity.Infrastructure.csproj" />
    <ProjectReference Include="..\Agentivity.Infrastructure.Workflow\Agentivity.Infrastructure.Workflow.csproj" />
    <ProjectReference Include="..\Agentivity.Infrastructure.Agentic\Agentivity.Infrastructure.Agentic.csproj" />
    <ProjectReference Include="..\Agentivity.Infrastructure.DataTables\Agentivity.Infrastructure.DataTables.csproj" />
    <ProjectReference Include="..\Agentivity.Infrastructure.KnowledgeBases\Agentivity.Infrastructure.KnowledgeBases.csproj" />
  </ItemGroup>

  <Target Name="CopyModuleToModulesDirectory" AfterTargets="Build">
    <MakeDir Directories="$(ModuleOutputDirectory)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModuleOutputDirectory)" SkipUnchangedFiles="true" />
  </Target>
  <Import Project="$(MSBuildThisFileDirectory)..\..\tools\build\Agentivity.Module.targets" Condition="Exists('$(MSBuildThisFileDirectory)..\..\tools\build\Agentivity.Module.targets')" />
</Project>
