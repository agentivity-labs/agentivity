<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Agentivity.Domain</RootNamespace>
    <RunAnalyzersDuringLiveAnalysis>False</RunAnalyzersDuringLiveAnalysis>
    <EnableNETAnalyzers>False</EnableNETAnalyzers>
  </PropertyGroup>
  <ItemGroup>
    <!-- Every icon Lucide offers (name + search tags), generated by tools/generate-icons.mjs — see IconCatalog. -->
    <EmbeddedResource Include="Icons\material-icons.json" LogicalName="Agentivity.Domain.Icons.material-icons.json" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Agentivity.Observability.Contracts\Agentivity.Observability.Contracts.csproj" />
  </ItemGroup>
</Project>

